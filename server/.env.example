# Server — copiază în .env și completează cu valorile tale

# Baza de date
DB_HOST=localhost
DB_PORT=5432
DB_NAME=photoforge
DB_USER=postgres
DB_PASS=

# JWT
JWT_SECRET=schimba_cu_un_string_aleatoriu_lung
JWT_EXPIRES_IN=7d

# Server
PORT=3001

# Frontend (pentru CORS)
FRONTEND_URL=http://localhost:5173

# Upload fișiere — lasă gol pentru a salva local; completează pentru Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=photoforge-uploads
R2_PUBLIC_URL=

# Email SMTP — lasă gol pentru a dezactiva trimiterea de emailuri
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="PhotoForge <noreply@photoforge.app>"
